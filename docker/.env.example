# ROS 2 domain of this drone. Mission frameworks and PX4 (UXRCE_DDS_DOM_ID) must use the same.
ROS_DOMAIN_ID=99
# UART wired to the flight controller's uXRCE-DDS port, and its baud (PX4 SER_TELn_BAUD).
PX4_UART_DEVICE=/dev/ttyTHS1
PX4_UART_BAUD=921600
# ROS 2 Jazzy + px4_msgs release/1.17 (the Pixhawks run PX4 1.17.x) + Micro XRCE-DDS Agent.
BASE_IMAGE=ghcr.io/skymule-ai/mullet-base:v0.5.1
