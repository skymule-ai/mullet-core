# The ROS 2 domain is not set here: it is ROS_DOMAIN_ID in /etc/mullet/drone.env (mullet-setup), shared
# by every Compose project on the drone. PX4's UXRCE_DDS_DOM_ID must equal it.
# UART wired to the flight controller's uXRCE-DDS port, and its baud (PX4 SER_TELn_BAUD).
PX4_UART_DEVICE=/dev/ttyTHS1
PX4_UART_BAUD=921600
